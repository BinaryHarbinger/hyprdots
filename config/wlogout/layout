{
    "label" : "lock",
    "action" : "hyprlock",
    "text" : "Lock",
    "keybind" : "l"
}

{
    "label" : "logout",
    "action" : "hyprctl dispatch exit && sleep 1 && loginctl terminate-user "$USER"",
    "text" : "Logout",
    "keybind" : "e"
}

{
    "label" : "suspend",
    "action" : "hyprlock -f & systemctl suspend",
    "text" : "Suspend",
    "keybind" : "u"
}

{
    "label" : "shutdown",
    "action" : "notify-send 'Shutting down...' &systemctl poweroff",
    "text" : "Shutdown",
    "keybind" : "s"
}

{
    "label" : "hibernate",
    "action" : "systemctl hibernate",
    "text" : "Hibernate",
    "keybind" : "h"
}

{
    "label" : "reboot",
    "action" : "systemctl reboot",
    "text" : "Reboot",
    "keybind" : "r"
}
