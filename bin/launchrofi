#!/usr/bin/env bash

cd ~

# Usage Information
usage() {
    echo -e "\n Usage:
      --drun                            : Launches the application launcher (drun).\n
      --run                             : Launches the command runner (run). \n
      --menu                            : Displays a custom menu with multiple options. \n
      --window                          : Displays a open windows.\n 
      --sys_menu                        : Displays system menu. \n
      --screenshot_menu                 : Displays system menu. \n
      --conf_launcher [title] [options] : Launches a confirmation dialog\n"
    exit 1
}

# Function: DRUN Launcher
drun_launcher() {
    walker
}

# Function: RUN Launcher
run_launcher() {
    walker -s run -p " Runner"
}

# Function: CONFIRMATION Launcher
conf_launcher() {
    
    local title
    if [[ -n "$1" ]]; then
        options="$1"
    else
        options="Confirm"
    fi

   local options
    if [[ -n "$2" ]]; then
        options="$2"
    else
        options="Yes\nNo"
    fi

    [[ -z "$1" ]] || local title="$1"
    chosen=$( echo -e "$options" |walker -d)
    echo "$chosen"
}

lock_menu() {
    # Menu options displayed in Walker
    cd ~/Dotfiles/scripts/
    options=$(python ~/Dotfiles/scripts/style_lock.py dmenu)
    # Prompt user to choose an option
    chosen=$(echo -e "󰌍\n$options" | walker -d -p "Go…" -t "system_menu")
    cd ~
    if [[ -z "$chosen" ]]; then 
        exit 1
    elif [[ "$chosen" = "󰌍" ]];then
        customize_func
    else
        cd ~/Dotfiles/scripts/
        argument="${chosen:3}"
        python style_lock.py "$argument"
        lock_menu
    fi

   $HOME/Dotfiles/bin/change-theme -c $chosen 


}

# Function: Custom Menu
quick_menu() {
    # Menu options displayed in Walker
    options="\n\n \n \n󰍂\n\n"

    # Prompt user to choose an option
    chosen=$(echo -e "$options" | walker -d -n -t "quick_menu")

    # Execute the corresponding command based on the selected option
    case $chosen in
        "")
            walker & disown
            ;;
        "")
            pcmanfm-qt
            ;;
        "󰍂")
            session_options
            ;;
        "")
            foot
            ;;
        "")
            bash ~/Dotfiles/scripts/open-browser
            ;;
        "")
            system_menu
            ;;
        "")
            manual_func
            ;;
        *)
            echo "No option selected"
            ;;
    esac
}

session_options() {
    # Menu options displayed in Walker
    options="  Shutdown\n  Reboot\n  Lock\n󰍃  Logout"

    # Prompt user to choose an option
    chosen=$(echo -e "$options" | walker -d -n -t "system_menu" --maxheight 500)

    # Execute the corresponding command based on the selected option
    case $chosen in
        "󰌍")
            system_menu
            ;;
        "  Shutdown")
            systemctl poweroff
            ;;
        "  Reboot")
            systemctl reboot
            ;;

        "  Lock")
            hyprlock & disown
            ;;
        "󰍃  Logout")
            pkill -KILL -u $USER && sleep 1 && loginctl terminate-user "$USER"
            ;;
        *)
            echo "No option selected"
            ;;
    esac
}


widget_settings() {
    # Menu options displayed in Walker
    options="󰌍\n  Desk Clock\n  Change Stats\n  Change Music\n  Reload Widgets\n  Initalize"

    # Prompt user to choose an option
    chosen=$(echo -e "$options" | walker -d -p "Go…" -t "system_menu")

    # Execute the corresponding command based on the selected option
    case $chosen in
        "󰌍")
            customize_func
            ;;
        "  Desk Clock")
            bash ~/Dotfiles/scripts/widgets.sh three
            bash ~/Dotfiles/scripts/widgets.sh r >/dev/null 2>&1 & disown
            widget_settings
            ;;
        "  Change Stats")
            bash ~/Dotfiles/scripts/widgets.sh one
            bash ~/Dotfiles/scripts/widgets.sh r >/dev/null 2>&1 & disown
            widget_settings
            ;;
        "  Change Music")
            bash ~/Dotfiles/scripts/widgets.sh two
            bash ~/Dotfiles/scripts/widgets.sh r >/dev/null 2>&1 & disown
            widget_settings
            ;;
        "  Reload Widgets")
            bash ~/Dotfiles/scripts/widgets.sh r >/dev/null 2>&1 & disown
            widget_settings
            ;;
        "  Initalize Widgets")
            bash ~/Dotfiles/scripts/widgets.sh r >/dev/null 2>&1 & disown
            widget_settings
            ;;
        *)
            echo "No option selected"
            ;;
    esac
}

default_apps_func() {
    # Menu options displayed in Walker
    options="󰌍\n  Browser\n󰠮  Editor"

    # Prompt user to choose an option
    chosen=$(echo -e "$options" | walker -d -p "Select" -t "system_menu")

    # Execute the corresponding command based on the selected option
    case $chosen in
        "󰌍")
            settings_func
            ;;
        "  Browser")
            bash ~/Dotfiles/scripts/set-default-browser
            default_apps_func
            ;;
        "󰠮  Editor")
            bash ~/Dotfiles/scripts/set-default-editor
            default_apps_func
            ;;
        *)
            ;;
    esac
}

settings_func() {
    # Menu options displayed in Walker
    options="󰌍\n  Activate Linux\n  Reload Shell\n  Set Default Apps\n󰌁  Customize Rice\n󰚰  Update Binarydots"

    # Prompt user to choose an option
    chosen=$(echo -e "$options" | walker -d -p "Go…" -t "system_menu")

    # Execute the corresponding command based on the selected option
    case $chosen in
        "󰌍")
            system_menu
            ;;
        "  Activate Linux")
            bash ~/Dotfiles/scripts/widgets.sh four
            bash ~/Dotfiles/scripts/widgets.sh r >/dev/null 2>&1 & disown
            settings_func
            ;;
        "  Reload Shell")
            pkill riftbar >/dev/null 2>&1 && riftbar >/dev/null 2>&1 & disown 
            pkill ewwii>/dev/null 2>&1 && bash ~/Dotfiles/scripts/widgets.sh r >/dev/null 2>&1 & disown
            pgrep "walker" > /dev/null && pkill walker >/dev/null 2>&1 & disown
( pgrep "Hyprland" > /dev/null 2>&1 || pgrep "hyprland" > /dev/null 2>&1 ) &&GSK_RENDERER=cairo walker --gapplication-service >/dev/null 2>&1 & disown
            makoctl reload   
            settings_func
            ;;
        "  Set Default Apps")
           default_apps_func 
            ;;
        "󰌁  Customize Rice")
            customize_func
            ;;
        "󰚰  Update Binarydots")
            foot --override=colors.alpha=1 --app-id=Update -e bash ~/Dotfiles/bin/update_binarydots
            cd ~
            settings_func
            ;;
        *)
            echo "No option selected"
            ;;
    esac
}


customize_func() {
    # Menu options displayed in Walker
    options="󰌍\n  Set Style Locks\n  Widgets Settings\n  Wallpapers\n󰌁  Themes"

    # Prompt user to choose an option
    chosen=$(echo -e "$options" | walker -d -p "Go…" -t "system_menu")

    # Execute the corresponding command based on the selected option
    case $chosen in
        "󰌍")
            settings_func
            ;;
        "  Set Style Locks")
            lock_menu
            ;;
        "  Widgets Settings")
            widget_settings
            ;;
        "󰌁  Themes")
            theme_menu
            ;;
        "  Wallpapers")
            set_wallpaper
            ;;
        *)
            echo "No option selected"
            ;;
    esac
}

set_wallpaper() {

    # Prompt user to choose an option
    chosen=$(python ~/Dotfiles/scripts/wallpapers.py echoImageNames | walker -d -p "Go…" -t "system_menu")
    # Execute the corresponding command based on the selected option
    echo $chosen
    python ~/Dotfiles/scripts/wallpapers.py changeWallpaper $chosen
}

maintain_menu() {
    # Menu options displayed in Walker
    options="󰌍\n󰃢  Clear Cache\n󱘡  Clear Clipboard"

    # Prompt user to choose an option
    chosen=$(echo -e "$options" | walker -d -p "Go…" -t "system_menu" )

    # Execute the corresponding command based on the selected option
    case $chosen in
        "󰌍")
            system_menu
            ;;
        "󰃢  Clear Cache")
         	find ~/.cache -mindepth 1 -maxdepth 1 \
         	  ! -name "spotify" \
         	  ! -name "cliphist" \
         	  ! -name "paru" \
         	  ! -name "mcpelauncher-webview"\
         	  ! -name "pip" \
         	  ! -name "Hyprland Polkit Agent" \
         	  ! -name "spotube" \
         	  ! -name "oss.krtirtho.spotube" \
         	  -exec rm -rf {} + >/dev/null 2>&1 & disown
            maintain_menu
            ;;
        "󱘡  Clear Clipboard")
            rm -rf ~/.cache/cliphist >/dev/null 2>&1 & disown
            maintain_menu
            ;; 
        *)
            echo "No option selected"
            ;;
    esac
}

manual_func() {
    # Menu options displayed in Walker
    options="󰌍\n  Keybinds"

    # Prompt user to choose an option
    chosen=$(echo -e "$options" | walker -d -p "Go…" -t "system_menu")

    # Execute the corresponding command based on the selected option
    case $chosen in
        "󰌍")
            system_menu
            ;;
        "  Keybinds")
            cat ~/.config/hypr/scripts/help.txt | walker -d
            ;;
        *)
            echo "No option selected"
            ;;
    esac
}

screenshot_func() {
    # Menu options displayed in Walker
    options="󰌍\n  Screenshots\n  Fullscreen\n  Selection"

    # Prompt user to choose an option
    chosen=$(echo -e "$options" | walker -d -p "Go…" -t "system_menu")

    # Execute the corresponding command based on the selected option
    case $chosen in
        "󰌍")
            system_menu
            ;;
        "  Screenshots")
            foot -e yazi ~/Pictures/Screenshots/
            ;;
        "  Fullscreen")
            hyprshot -m output -o ~/Pictures/Screenshots && notify-send -i camera "Hyprshot" "Saved to ~/Pictures/Screenshots"
            ;;
        "  Selection")
            hyprshot -m region -o ~/Pictures/Screenshots && notify-send -i camera "Hyprshot" "Saved to ~/Pictures/Screenshots"
            ;;
        *)
            echo "No option selected"
            ;;
    esac
}

connections_func() {
    # Menu options displayed in Walker
    options="󰌍\n󰤨  WiFi\n  Bluetooth"

    # Prompt user to choose an option
    chosen=$(echo -e "$options" | walker -d -p "Go…" -t "system_menu")

    # Execute the corresponding command based on the selected option
    case $chosen in
        "󰌍")
            system_menu
            ;;
        "󰤨  WiFi") 
            bash ~/Dotfiles/scripts/walker-wifi
            ;;
        "  Bluetooth")
            bash ~/Dotfiles/scripts/walker-bluetooth 
            ;;
        *)
            echo "No option selected"
            ;;
    esac
}

misc_func() {
    # Menu options displayed in Walker
    options="󰌍\n  Toggle DND\n  Toggle Cafein\n󰈈  Toggle Eye Saver"

    # Prompt user to choose an option
    chosen=$(echo -e "$options" | walker -d -p "Go…" -t "system_menu")

    # Execute the corresponding command based on the selected option
    case $chosen in
        "󰌍")
            system_menu
            ;;
        "  Toggle DND")
            makoctl mode -t dnd
            misc_func
            ;;
        "  Toggle Cafein")
            bash $HOME/Dotfiles/scripts/cafein toggle -n
            misc_func
            ;;
        "󰈈  Toggle Eye Saver")
            bash $HOME/Dotfiles/scripts/toggle-sunset
            misc_func
            ;;
        *)
            echo "No option selected"
            ;;
    esac
}

system_menu() {
    # Menu options displayed in Walker
    options="  Apps\n  Connections\n󰃢  Maintaining\n󰅇  Clipboard\n󰄀  Screenshot\n󰐱  Miscellaneous\n  Notifications\n󰍂  Session Options\n  Manual\n󰌁  Themes\n  Settings\n  Update System"

    # Prompt user to choose an option
    chosen=$(echo -e "$options" | walker -d -p "Go…" -t "system_menu")

    # Execute the corresponding command based on the selected option
    case $chosen in
        "  Apps")
            drun_launcher
            ;;
        "  Connections")
            connections_func
            ;;
        "󰃢  Maintaining")
            maintain_menu
            ;;
        "󰅇  Clipboard")
            walker -s clippy -p "󰅇 Clipboard" 
            ;;
        "󰄀  Screenshot")
            screenshot_func 
            ;;
        "󰐱  Miscellaneous")
            misc_func 
            ;;
        "  Notifications")
            bash ~/.config/mako/scripts/walker.sh
            ;;
        "󰍂  Session Options")
            session_options
            ;;
        "  Update System")
            foot --override=colors.alpha=1 --app-id=Update -e bash ~/Dotfiles/bin/update
            ;;
        "󰌁  Themes")
            theme_menu
            ;;
        "  Settings")
            settings_func
            ;;
        "  Manual")
            manual_func
                    ;;
        *)
            echo "No option selected"
            ;;
    esac
}

theme_menu() {
   THEME_DIR="$HOME/.config/binarydots/themes"

    # Menu options displayed in Walker
    THEMES=$(find "$THEME_DIR" -mindepth 1 -maxdepth 1 -type d -printf '%f\n')
    # Prompt user to choose an option
    chosen=$(echo -e "󰌍\n$THEMES" | walker -d -p "Go…" -t "system_menu")
    
    if [[ -z "$chosen" ]]; then 
        exit 1
    elif [[ "$chosen" = "󰌍" ]];then
        system_menu
    fi

   $HOME/Dotfiles/bin/change-theme -c $chosen 

}



# Check for flags and validate input
if [[ $# -ne 1 ]]; then
    if [[ "$1" != "--conf_launcher" ]]; then
        usage 
    fi
fi

# Execute the appropriate function based on the provided flag
case "$1" in
    --drun|-d)
        drun_launcher
        ;;
    --window|-w)
        walker -s window -p "󰘔  Windows"
        ;; 

    --run|-r)
        run_launcher
        ;;
    --menu|-m|-qm)
        quick_menu
        ;;
    --power-menu|-pm)
        session_options
        ;;
    --widget_settings|-ws)
    	widget_settings
    	;;
     --rice_settings|-rs)
     	settings_func
     	;;
     --system_menu|--sys_menu|-sm)
     	system_menu
     	;;
    --screenshot_menu|--ss_menu|-ss)
     	screenshot_func
     	;;
    --conf_launcher|-cl)
        conf_launcher "$2" "$3"
        ;;
    *)
        usage
        ;;
esac
