#!/bin/bash

# Script to sync Binarydots with git version

# Colors for output
GREEN="\e[32m"
RED="\e[31m"
BLUE="\e[34m"
RESET="\e[0m"

info() { gum style --foreground "#49A22C" -- <<< "➤ $1"; }
error() { gum style --foreground "#FF5555" -- <<< "✖ $1"; }

process() {
    local title="$1"
    shift
    gum spin --spinner dot --title "$title" -- "$@" 
}

wait_for_input () {
    echo -e ""
    gum style --foreground "#CCCCFF" -- <<< "➤ Press Enter to continue…"; stty -echo; read; stty echo
}

# ASCII banner
echo -e "\n\n${RESET}░█▀▄░▀█▀░█▀█░█▀█░█▀▄░█░█░█▀▄░█▀█░▀█▀░█▀▀
░█▀▄░░█░░█░█░█▀█░█▀▄░░█░░█░█░█░█░░█░░▀▀█
░▀▀░░▀▀▀░▀░▀░▀░▀░▀░▀░░▀░░▀▀░░▀▀▀░░▀░░▀▀▀${RESET}"

echo -e "${GREEN}       ░█░█░█▀█░█▀▄░█▀█░▀█▀░█▀▀
       ░█░█░█▀▀░█░█░█▀█░░█░░█▀▀
       ░▀▀▀░▀░░░▀▀░░▀░▀░░▀░░▀▀▀${RESET}"

echo 
cd ~/Dotfiles/ || { error "Dotfiles directory not found!"; wait_for_input; exit 1; }

git fetch origin

if ! git diff --quiet HEAD origin/$(git rev-parse --abbrev-ref HEAD); then

    # Read old packages
    OLD_PACKAGES=($(cat PACKAGES)) || true

    # === Git update ===
    
    # Save local changes (if any)
    process "Saving local changes..." bash -c '
        git diff --quiet && git diff --cached --quiet && echo "No local changes to stash." || git stash push --include-untracked -m temp || true
'

    # Pull new commits with rebase as default
    process "Pulling new commits (rebase)..." bash -c '
        git config pull.rebase true
        git pull --rebase -X ours || true
'

    # Restore local changes (if any)
    process "Restoring local changes..." bash -c '
    git stash list | grep -q "temp" && git stash pop || echo "No stash to pop."
'

    info "Git update completed."
    
    if [ -f PACKAGES ]; then
        PACKAGES=($(cat PACKAGES)) || { error "Failed to read new packages!"; wait_for_input; exit 1; }
    else
        PACKAGES=()
    fi

    # Compare old and new packages
    only_in_OLD=()
    only_in_NEW=()

    for a in "${OLD_PACKAGES[@]}"; do
        found=false
        for b in "${PACKAGES[@]}"; do
            if [ "$a" = "$b" ]; then
                found=true
                break
            fi
        done
        if [ "$found" = false ]; then
            only_in_OLD+=("$a")
        fi
    done

    for b in "${PACKAGES[@]}"; do
        found=false
        for a in "${OLD_PACKAGES[@]}"; do
            if [ "$b" = "$a" ]; then
                found=true
                break
            fi
        done
        if [ "$found" = false ]; then
            only_in_NEW+=("$b")
        fi
    done
   

    # Get sudo password
    if [ "${#only_in_OLD[@]}" -gt 0 ] || [ "${#only_in_NEW[@]}" -gt 0 ]; then
        echo "Installed packages will modify."
        sudo -v || error 'Failed to get sudo password!'
    fi


    # Remove old packages
    if [ "${#only_in_OLD[@]}" -gt 0 ]; then
        if [ "${#only_in_OLD[@]}" -gt 0 ]; then
            process "Removing old packages..." paru -Rns --noconfirm "${only_in_OLD[@]}"
        fi
    fi

    # Install new packages
    if [ "${#only_in_NEW[@]}" -gt 0 ]; then
        if [ "${#only_in_NEW[@]}" -gt 0 ]; then
            paru -Syu --needed --noconfirm "${only_in_NEW[@]}"
        fi
    fi

    info "Updated successfully."
    hyprctl reload
    wait_for_input
    exit 0

else
    info "BinaryDots are up to date!"
    wait_for_input
    exit 0
fi

