#!/bin/bash
set -euo pipefail

# Start scrcpy in background (audio only)
scrcpy --no-video --audio-source=mic >/dev/null 2>&1 &
SCRCPY_PID=$!

# Give scrcpy time to initialize ADB + audio
sleep 0.5

# Check whether scrcpy is still running
if ! kill -0 "$SCRCPY_PID" 2>/dev/null; then
	echo "Error: scrcpy failed to start or exited immediately" >&2
	exit 1
fi

# Detach scrcpy from this shell
disown "$SCRCPY_PID"

# Create PipeWire loopback: scrcpy sink -> virtual microphone
pw-loopback \
	--capture=scrcpy \
	--playback-props='{ media.class = "Audio/Source", node.description = "Android Mic" }'
